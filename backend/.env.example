ETSY_KEYSTRING=replace_with_etsy_keystring
ETSY_SHARED_SECRET=replace_with_etsy_shared_secret
ETSY_REDIRECT_URI=https://your-domain.example.com/etsy/callback
# 可选：仅 Etsy API 和 Token 请求使用的 HTTP 代理。
ETSY_PROXY_URL=
PORT=3001
DASHBOARD_TIME_ZONE=Asia/Shanghai
# 云端请挂载持久化目录，并让所有实例共享同一目录。
RUNTIME_DATA_DIR=/app/data
# 云端服务器可访问的广告 CSV 目录；不要填写本地电脑或局域网 UNC 路径。
ETSY_AD_REPORT_DIR=/app/data/ads

HUALEI_API_BASE=http://your-hualei-api.example.com
HUALEI_LABEL_BASE=http://your-hualei-label.example.com
HUALEI_USERNAME=replace_with_hualei_username
HUALEI_PASSWORD=replace_with_hualei_password
HUALEI_CUSTOMER_ID=replace_with_hualei_customer_id
HUALEI_CUSTOMER_USER_ID=replace_with_hualei_customer_user_id

LOGISTICS_FEES_API_URL=https://kaixue.app.n8n.cloud/webhook/logistics-fees/latest
LOGISTICS_FEES_API_TOKEN=
LOGISTICS_FEES_API_HEADER_NAME=x-dashboard-token

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kanban_main
MYSQL_USER=replace_with_mysql_user
MYSQL_PASSWORD=replace_with_mysql_password
